NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# AI features (server only - never put NEXT_PUBLIC_ in front of this key)
GEMINI_API_KEY=your-google-ai-studio-api-key
# optional: GEMINI_MODEL=gemini-2.5-flash
# Automatic e-mail alerts (resend.com): free plan, verify your domain to send to customers
RESEND_API_KEY=re_...
RESEND_FROM=AUTOUSAKHATIA <alerts@your-domain.com>
# Weekly Market Radar (server only). Service role key: Supabase -> Project Settings -> API (keep secret!)
SUPABASE_SERVICE_ROLE_KEY=...
CRON_SECRET=make-up-a-long-random-string
